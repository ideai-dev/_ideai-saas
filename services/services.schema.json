{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Services Registry",
  "description": "Schema for services.json - single source of truth for service discovery and indexing",
  "type": "object",
  "required": ["version", "services"],
  "properties": {
    "version": { "type": "string" },
    "description": { "type": "string" },
    "services": { "type": "array", "items": { "$ref": "#/definitions/service" } },
    "apps": { "type": "array", "items": { "$ref": "#/definitions/app" } },
    "categories": { "type": "object", "additionalProperties": { "type": "string" } },
    "tagIndex": { "type": "array", "items": { "type": "string" } }
  },
  "definitions": {
    "service": {
      "type": "object",
      "required": ["id", "name", "slug", "description", "status", "path"],
      "properties": {
        "id": { "type": "string" },
        "name": { "type": "string" },
        "slug": { "type": "string" },
        "description": { "type": "string" },
        "descriptionLong": { "type": "string" },
        "tags": { "type": "array", "items": { "type": "string" } },
        "category": { "type": "string" },
        "language": { "type": "string" },
        "runtime": { "type": "string" },
        "framework": { "type": ["string", "null"] },
        "status": { "type": "string", "enum": ["active", "planned"] },
        "path": { "type": "string" },
        "defaultPort": { "type": ["integer", "null"] },
        "providers": { "type": "array", "items": { "type": "string" } },
        "capabilities": { "type": "array", "items": { "type": "string" } },
        "dependsOn": { "type": "array", "items": { "type": "string" } },
        "healthPath": { "type": "string" },
        "indexHint": { "type": "string" }
      }
    },
    "app": {
      "type": "object",
      "required": ["id", "name", "path", "type"],
      "properties": {
        "id": { "type": "string" },
        "name": { "type": "string" },
        "path": { "type": "string" },
        "type": { "type": "string", "enum": ["gateway", "frontend", "api"] },
        "description": { "type": "string" },
        "tags": { "type": "array", "items": { "type": "string" } },
        "defaultPort": { "type": ["integer", "null"] },
        "consumes": { "type": "array", "items": { "type": "string" } },
        "exposes": { "type": "array", "items": { "type": "string" } },
        "healthPath": { "type": "string" }
      }
    }
  }
}
